# Variables de entorno — LinkedIn Manager Backend
# Copiá este archivo a .env y completá los valores

# Puerto del servidor
PORT=8000

# Entorno: development | production
NODE_ENV=development

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Clave secreta para cifrar las cookies almacenadas
SECRET_KEY=cambia_esto_por_una_clave_secreta_larga_y_aleatoria

# Playwright: abrir browser con interfaz gráfica (true) o headless (false)
# En producción: HEADLESS=true
HEADLESS=false

# Delay entre acciones de LinkedIn (ms). Mínimo recomendado: 2000
# Aumentar si LinkedIn detecta actividad inusual
ACTION_DELAY_MIN=2000
ACTION_DELAY_MAX=8000

# Límite global de acciones por cuenta por día
GLOBAL_DAILY_LIMIT=150

# SQLite database path (relativo al directorio backend/)
DB_PATH=./data/linkedin_manager.db
